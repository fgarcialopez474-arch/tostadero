# Copia este fichero como .env y rellena los valores. El .env NUNCA se sube a git.

# --- Base de datos (Neon: Dashboard > Connect) ---
# Conexion con pooler, el host lleva "-pooler" (la usa la app)
DATABASE_URL="postgresql://USUARIO:CONTRASENA@ep-xxxx-pooler.REGION.aws.neon.tech/tostadero?sslmode=verify-full"
# Conexion directa, sin "-pooler" (la usan las migraciones de Prisma)
DIRECT_URL="postgresql://USUARIO:CONTRASENA@ep-xxxx.REGION.aws.neon.tech/tostadero?sslmode=verify-full"
